# ============================================================================
# 复制为 .env.local 用于本地开发。生产/预发值由 CI secrets 注入。
# ============================================================================

# --- 站点 -------------------------------------------------------------------
# 站点根 URL。静态导出没有运行时，这个值在构建期被烘进 OG 图/canonical/sitemap，
# 因此每个环境的构建都必须传对。
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 注：ICP 备案号不在这里 —— 它是 Prismic settings 单例里的 icp_license 字段，
# 由编辑维护，备案号变更时不需要动代码或改 CI。

# --- Prismic ----------------------------------------------------------------
# 内容 API access token。仓库 API 设为 private 后必需；public 时可留空。
# 服务端专用，绝不加 NEXT_PUBLIC_ 前缀。
PRISMIC_ACCESS_TOKEN=""

# 预发构建用：指定要构建的 Release。留空则构建 master（已发布内容）。
# 二者传其一即可，label 更直观。
# 查询非 master ref 需要一个「允许访问其他 ref」的 token（见 PRISMIC_ACCESS_TOKEN）。
PRISMIC_RELEASE_LABEL=""
PRISMIC_RELEASE_ID=""
