{
  "format": "custom",
  "id": "settings",
  "json": {
    "Main": {
      "site_name": {
        "config": {
          "label": "站点名称"
        },
        "type": "Text"
      },
      "site_tagline": {
        "config": {
          "label": "一句话定位"
        },
        "type": "Text"
      },
      "logo": {
        "config": {
          "label": "Logo"
        },
        "type": "Image"
      },
      "primary_nav": {
        "config": {
          "allowText": true,
          "label": "主导航",
          "repeat": true
        },
        "type": "Link"
      },
      "footer_nav": {
        "config": {
          "allowText": true,
          "label": "页脚导航",
          "repeat": true
        },
        "type": "Link"
      },
      "footer_note": {
        "config": {
          "label": "页脚说明",
          "multi": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      },
      "icp_license": {
        "config": {
          "label": "ICP 备案号",
          "placeholder": "京ICP备00000000号-1"
        },
        "type": "Text"
      },
      "miniprogram_icp_license": {
        "config": {
          "label": "小程序备案号",
          "placeholder": "京ICP备00000000号-2X"
        },
        "type": "Text"
      },
      "police_license": {
        "config": {
          "label": "公安备案号",
          "placeholder": "京公网安备00000000000000号"
        },
        "type": "Text"
      },
      "police_license_link": {
        "config": {
          "label": "公安备案查询链接",
          "select": "web"
        },
        "type": "Link"
      },
      "contact_email": {
        "config": {
          "label": "联系邮箱"
        },
        "type": "Text"
      },
      "contact_phone": {
        "config": {
          "label": "联系电话"
        },
        "type": "Text"
      },
      "contact_address": {
        "config": {
          "label": "办公地址"
        },
        "type": "Text"
      },
      "social_links": {
        "config": {
          "fields": {
            "platform": {
              "config": {
                "label": "平台",
                "options": [
                  "wechat",
                  "weibo",
                  "linkedin",
                  "github",
                  "youtube",
                  "x"
                ]
              },
              "type": "Select"
            },
            "link": {
              "config": {
                "label": "链接",
                "select": "web"
              },
              "type": "Link"
            }
          },
          "label": "社交账号"
        },
        "type": "Group"
      },
      "baidu_analytics_id": {
        "config": {
          "label": "百度统计 ID",
          "placeholder": "hm.js?<ID> 里的那串 ID"
        },
        "type": "Text"
      }
    },
    "小程序": {
      "miniprogram_cta_label": {
        "config": {
          "label": "小程序按钮文案",
          "placeholder": "打开小程序"
        },
        "type": "Text"
      },
      "miniprogram_qrcode": {
        "config": {
          "label": "小程序二维码"
        },
        "type": "Image"
      },
      "miniprogram_qr_title": {
        "config": {
          "label": "扫码弹窗标题",
          "placeholder": "微信扫码打开"
        },
        "type": "Text"
      },
      "miniprogram_qr_description": {
        "config": {
          "label": "扫码弹窗说明",
          "placeholder": "使用微信扫描下方二维码，即可打开小程序。"
        },
        "type": "Text"
      },
      "miniprogram_qr_note": {
        "config": {
          "label": "扫码弹窗脚注",
